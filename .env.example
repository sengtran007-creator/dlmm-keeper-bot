# === Required ===
# Base58-encoded Solana keypair secret for the LP bot wallet (never commit the real value).
BOT_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY

# Solana JSON-RPC endpoint (prefer a private provider; do not embed API keys in git).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Alias also accepted by the bot:
# RPC_URL=https://api.mainnet-beta.solana.com

# Public key that receives harvested fee USDC transfers.
REVENUE_WALLET_PUBKEY=YOUR_REVENUE_WALLET_PUBKEY

# === Pool / instance (multi-pool) ===
# Meteora SOL-USDC DLMM pool. Unset = the original 10 bps pool BGm1tav58oGcsQJehL9WXBFXF7D27vZsKefj4xJKD5Y.
# 4 bps pool: 5rCf1DM8LjKTw4YqhnoLcngyZYeNnQqztScTogYHAS6. Bin step is read from the pool at boot; the bot
# refuses to start if the pool is not SOL(X)/USDC(Y). Each pool instance needs its OWN wallet (BOT_PRIVATE_KEY).
POOL_ADDRESS=
# Label added to every Telegram message ("[4bps] ...") and to every ledger row (`instance`). Alias: BOT_NAME.
INSTANCE_LABEL=
# Range for NEW positions, in THIS pool's bins (one side set → mirrored). Clamped to 70 bins total.
# Unset = regime profile (designed for 10 bps bins) converted to the same price width on this bin step
# (RANGE 30/30 @10bps → 34/35 @4bps after the 70-bin clamp). Set both to force a fixed shape in every regime.
BID_BINS=
ASK_BINS=
# Alternative to BID/ASK_BINS: symmetric half-width in percent (e.g. 1.4 = ±1.4%).
RANGE_WIDTH_PCT=
# Default true. Give each instance its OWN TELEGRAM_BOT_TOKEN (BotFather) so both keep full commands.
# false = notifications only, no getUpdates polling (only for an instance that shares another's token → HTTP 409).
TELEGRAM_COMMANDS_ENABLED=true

# === /transfer_out (optional; disabled when TRANSFER_OUT_ALLOWLIST is unset) ===
# Exactly ONE destination wallet public key. The destination is never taken from Telegram. Not the LP or revenue wallet.
# Flow: /withdraw_pct N (pauses) → /transfer_out <usd>|<pct>% [usdc] → /confirm <code> within 60s → /resume.
# Needs TELEGRAM_CHAT_ID. Sends USDC first, then native SOL above GAS_RESERVE + margin + fee (+ new-ATA rent).
# The capital withdrawal is recorded on chain (memo) and re-derived at boot: do NOT also add it to NET_DEPOSITS_USD.
TRANSFER_OUT_ALLOWLIST=
# Optional Telegram user ids allowed to request/confirm (comma-separated). Empty = anyone in TELEGRAM_CHAT_ID.
TRANSFER_OUT_USER_IDS=
# Per-transfer caps: USD (default 600, hard ceiling 5000) and % of live equity (default 60, max 90).
TRANSFER_OUT_MAX_USD=600
TRANSFER_OUT_MAX_EQUITY_PCT=60
# Extra native SOL kept above GAS_RESERVE_LAMPORTS when sending SOL (default 0.01 SOL).
TRANSFER_OUT_SOL_MARGIN_LAMPORTS=10000000
# Fallback only if the boot scan of past transfers fails/is incomplete (USD already transferred out).
TRANSFER_OUT_PRIOR_USD=

# === Strongly recommended (Telegram ops) ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# === Optional observability ===
# Google Apps Script / webhook URL for PnL sheet posts. If unset, sheet logging is skipped.
GOOGLE_SHEET_WEBHOOK_URL=

# === P&L baseline (reporting only — never used by stops, take-profit, recenter or sizing) ===
# Net PnL = live equity (position + wallet) + swept to revenue − (STARTING_CAPITAL_USD + NET_DEPOSITS_USD)
# Top-ups, deploys, recenters, swaps and wrap/unwrap are internal moves and never change the baseline.
# Authoritative starting capital (USD) contributed to the LP wallet. If unset, the baseline falls back
# to mark-to-market equity at boot, so PnL is only "since this boot".
STARTING_CAPITAL_USD=
# Optional: external deposits minus withdrawals AFTER the starting capital (USD, may be negative).
# Do NOT include fee sweeps to REVENUE_WALLET_PUBKEY here — those are tracked separately.
NET_DEPOSITS_USD=
# FALLBACK ONLY: USD already swept to the revenue wallet before the current boot. The bot derives this
# on-chain at boot (sum of LP-wallet → revenue-ATA USDC transfers); this value is used only if that scan
# fails or is incomplete. Normally leave unset. Only applied when STARTING_CAPITAL_USD is set.
PRIOR_SWEPT_USD=

# === Fee-sweep schedule (survives restarts) ===
# The 24h clock is read from chain at boot (latest LP-wallet → revenue-ATA USDC transfer), so restarts
# don't reset it. A due sweep that moves nothing is retried after SWEEP_RETRY_SEC, not every tick.
SWEEP_INTERVAL_SEC=86400
SWEEP_RETRY_SEC=3600
# Fallback last-sweep unix time if the on-chain lookup fails or finds no sweep (else boot time).
LAST_SWEEP_UNIX=
# Max signatures scanned (each) on the revenue USDC ATA and the revenue wallet at boot.
SWEEP_SCAN_MAX_SIGS=2000
# Deprecated alias for STARTING_CAPITAL_USD (used only when STARTING_CAPITAL_USD is unset).
# BASELINE_USD=

# === Optional Jupiter / Gate 2 / gas tunables (code has defaults) ===
# Free lite base: https://lite-api.jup.ag/swap/v1  |  Pro: https://api.jup.ag/swap/v1 (+ API key)
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
JUPITER_SLIPPAGE_BPS=50

# Max Meteora *variable* fee in basis points allowed before re-entry Gate 2 blocks. Unset = 15 bps on the
# 10 bps pool, scaled by the pool's variableFeeControl elsewhere (= same volatility tolerance; 45 on 4 bps).
GATE2_MAX_VARIABLE_FEE_BPS=

# Lamports kept as SOL gas/rent reserve; warn when balance falls below WARN.

# === Floor-stop / recenter (new) ===
# Max mark-to-market equity drawdown vs entry before hard stop (fraction). Default 0.05 = 5%.
MAX_DRAWDOWN_PCT=0.05
# Consecutive 15s keeper ticks with spot below range floor before soft recenter (no SOL dump).
BELOW_RANGE_TICKS=3
# Min seconds between soft recenters (below-range or take-profit recycle).
RECENTER_COOLDOWN_SEC=1800
# Optional: after a recenter/take-profit whose close FAILED (position re-attached, nothing redeployed),
# retry it after this many seconds instead of the full RECENTER_COOLDOWN_SEC (min 30, default 180).
# RECENTER_FAIL_RETRY_SEC=180
# Optional close/claim tx resilience (defaults shown). Each close attempt re-reads the chain, rebuilds the
# tx and uses a fresh blockhash; backoff base*2^(n-1) capped at max, +-20% jitter.
# CLOSE_MAX_ATTEMPTS=4
# CLOSE_RETRY_BASE_MS=2000
# CLOSE_RETRY_MAX_MS=16000
# CLAIM_MAX_ATTEMPTS=3
# CLOSE_AFTER_SWEEP_DELAY_MS=1500
# Optional entry PIN: keep the original entry (and therefore the stops) across a restart.
# Applied ONLY at boot-attach and ONLY if the attached position pubkey == ENTRY_POSITION_PUBKEY.
# Without ENTRY_POSITION_PUBKEY the two values are ignored. After a take-profit / recenter / new deploy
# the position pubkey changes, so a stale pin is ignored automatically (warning in logs + Telegram).
# The bot logs the exact line to copy after every deploy/attach: "[ENTRY] To keep this entry across restarts set: ..."
ENTRY_POSITION_PUBKEY=
ENTRY_SPOT_USD=
ENTRY_EQUITY_USD=
# Price-stop % locked for the pinned position (fraction: 0.05 = 5%). Same rules as above. If unset (or the pin
# doesn't match) an attached position gets RANGE_CHOP's 5% — never the live regime — so restarts can't move the stop.
ENTRY_STOP_PCT=

# === Read guard (stop safety; stop thresholds themselves are unchanged) ===
# A failed/partial/implausible on-chain read skips the stop for that tick instead of firing it.
# Consecutive suspicious reads before a suspicious value is accepted as real.
SUSPECT_CONFIRM_TICKS=3
# One-tick spot move above this (fraction) is suspect.
SPOT_JUMP_MAX_PCT=0.2
# One-tick position-value drop above POS_DROP_MAX_PCT while spot moved < POS_DROP_SPOT_MOVE_PCT is suspect.
POS_DROP_MAX_PCT=0.5
POS_DROP_SPOT_MOVE_PCT=0.05
# Telegram "STOPS BLIND" alert when a stop has had no trustworthy read for this many seconds.
STOP_BLIND_ALERT_SEC=300
# At most one ERROR ledger row per this many seconds for failed reads.
READ_ERROR_LEDGER_SEC=900

# === Capital deployment / top-up ===
# Fraction of idle wallet capital to put into the grid (1.0 = ~100%, leaving only GAS_RESERVE).
DEPLOY_PCT=1.0
# Skip Jupiter rebalance swaps smaller than this USD notional.
MIN_SWAP_USD=10
# While a position is live, add idle wallet capital above this USD via addLiquidityByStrategy.
TOPUP_MIN_USD=20
TOPUP_COOLDOWN_SEC=900
# Periodic SNAPSHOT ledger rows (seconds).
SNAPSHOT_INTERVAL_SEC=3600

# Gas reserve defaults: 0.12 SOL reserve / 0.08 SOL warn (see code comments for rent math).
GAS_RESERVE_LAMPORTS=120000000
GAS_WARN_LAMPORTS=80000000
# Closes / withdrawals and fee claims only need this much native SOL (they don't spend the reserve;
# a close refunds position rent). Default 0.01 SOL.
TX_FEE_FLOOR_LAMPORTS=10000000

# === Claimed fee SOL → revenue (see README "Fee SOL handling") ===
# Jupiter SOL→USDC attempts (a retry only after the previous tx is proven not landed).
FEE_SOL_SWAP_ATTEMPTS=2
# Don't try a Jupiter swap below this (lamports); smaller amounts go straight to the native transfer.
FEE_SOL_SWAP_MIN_LAMPORTS=5000000
# Native SOL fallback: minimum to send, and margin kept above GAS_RESERVE_LAMPORTS.
FEE_SOL_SWEEP_MIN_LAMPORTS=1000000
FEE_SOL_SWEEP_MARGIN_LAMPORTS=5000000
# One-time catch-up of leftover fee SOL (guarded by an on-chain memo id; remove after it runs).
CATCHUP_SOL_SWEEP_LAMPORTS=
CATCHUP_SOL_SWEEP_ID=2026-10-09
CATCHUP_SOL_SWEEP_MAX_LAMPORTS=50000000
CATCHUP_SOL_SWEEP_DELAY_SEC=180
